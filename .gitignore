.venv
.venv.lustre/
.venv.sqfs
*.sqfs

# Make stamp dir
.make/

# Others
.DS_Store
.idea/
.vscode/
*.swp

# Python packaging 
*.egg-info/
/build/
lsms_library/countries/build/
/site/
/poetry.lock
# Mypy cache
.mypy_cache/

# Ignore contents of "dist" directory but keep the directory itself
dist/*
!dist/.gitkeep

# Other DVC credentials and cache directories
# Ignore all .dvc directories
**/.dvc/
.dvc/cache/
.dvc/tmp/
.dvc/plots/
lsms_library/.s3_creds

# Except! Don't ignore specific files within lsms_library/countries/.dvc/
!lsms_library/countries/.dvc/config
!lsms_library/countries/.dvc/s3_reader_creds.gpg
!lsms_library/countries/.dvc/s3_config

# Ignore data file extensions
*.parquet
*.dta
*.DTA
*.csv
*.CSV
*.sav
*.SAV
*.dat
*.DAT
*.DCT
*.FMT
*.SSP
*.TXT
*.var
*.VAR
*.WK1
*.zip
*.ZIP

# Ignore all files but .gitkeep in lsms_library/countries/*/var/
lsms_library/countries/*/var/*
!lsms_library/countries/*/var/.gitkeep

# Ignore particular files involving credentials
/Uganda/_/compare_unit_labels.py
# --- config CSVs under a country's _/ : SELECTED un-ignores (GH #790) -----
# `*.csv` above keeps microdata out of git.  But `.csv` is also in
# `_BUILD_INPUT_SUFFIXES`, so a CSV in a country's `_/` is a hashed build
# input -- invisible to git and load-bearing for cache freshness at the same
# time.  That combination made two clean checkouts of the same commit
# disagree on all 28 of Uganda's cache hashes, silently, because a generated
# `fct_usda.csv` existed in one of them and not the other.
#
# These are configuration and curated reference tables, not microdata, so
# un-ignore them BY NAME -- deliberately not a blanket `_/*.csv`, which would
# re-admit anything anyone drops in that directory.  A generated one then
# shows up in `git status` instead of shifting hashes unseen.
#
# The previous line here was `/Uganda/_/unitlabels.csv`, anchored at the repo
# root and therefore stale since countries moved under `lsms_library/`; it had
# stopped matching anything.
!lsms_library/countries/*/_/fct_*.csv
!lsms_library/countries/*/_/unitlabels.csv
!lsms_library/countries/*/_/unit_labels.csv
!lsms_library/countries/*/_/food_items.csv
!lsms_library/countries/*/_/central_american_fct*.csv
!lsms_library/countries/*/*/_/food_label.csv
!lsms_library/countries/*/*/_/ihs3_conversions.csv
!lsms_library/countries/Panama/1997/Data/unittable.csv

# Other ignored patterns
.coder-session/
.gitnexus

# Feature-audit run artifacts (results.jsonl / scan.log / memos)
bench/feature_audit/results/

# Coverage-matrix HTML readout (ephemeral artifact; the committed journal is
# .coder/coverage/latest.csv).  bench/build_feature.py profiling output too.
bench/results/

# ...but the coverage-matrix journal + blessing list ARE tracked (override the
# global *.csv ignore above; .coder/ itself is not ignored so this works).
!.coder/coverage/latest.csv
!.coder/coverage/blessed.csv
