    {
      "priority": "P2",
      "location": "lsms_library/transformations.py:1645",
      "title": "Thousands recognition rejects zero-padded groups allowed by the exact issue grammar",
      "authority": "GH #1143: \\d{1,3}(,\\d{3})+ is thousands unless token starts with literal 0,.",
      "actual": "[1-9]\\d{0,2}(?:,\\d{3})+",
      "cases": {
        "01,500 kg": {
          "expected": 1500.0,
          "actual": null
        },
        "001,500 kg": {
          "expected": 1500.0,
          "actual": null
        },
        "000,500 kg": {
          "expected": 500.0,
          "actual": null
        },
        "0,500 kg": {
          "expected": 0.5,
          "actual": 0.5
        }
      },
      "requested_fix": "Implement the literal issue grammar with only its literal 0, exception and add zero-padded first-group tests. No new numeric convention is needed."
    },
    {
      "priority": "P2_ADJACENT_HARDENING",
      "location": "lsms_library/transformations.py:1778",
      "title": "Exponent-like fragments with repeated signs or whitespace still leak numeric suffixes",
      "preexisting": true,
      "actual_cases": {
        "1e--3kg": 3.0,
        "1e++3kg": 3.0,
        "1e -3 kg": 3.0,
        "1e+ 3 kg": 3.0
      },
      "expected_for_scoped_unsupported_exponent_fragments": null,
      "reason": "Current prefix check handles only digit[eE] followed by at most one sign immediately before the number. The broader claim that unsupported exponent-like fragments decline is not true for these forms. This is not a new regression, and no live-data effect is established.",
      "requested_fix": "Narrowly extend current prefix guard for repeated signs/whitespace after digit[eE]; retain existing ranges/multipliers/numbered labels and scope documentation rather than redesigning syntax."
    }
  ],
