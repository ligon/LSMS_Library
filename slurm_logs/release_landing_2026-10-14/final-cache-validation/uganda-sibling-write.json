  "source_sha": "3914d8804d7b2936d75041cea98bbc9ddb6d4c9f",
  "mechanism": "Uganda Makefile lines142-143 give nutrition and fct the same nutrition.py recipe; the script writes fct then nutrition through to_parquet without cache_hash. The normal country caller verifies/stamps only its requested fct result, leaving nutrition hashless.",
  "recipe": "$(VAR_DIR)/nutrition.parquet $(VAR_DIR)/fct.parquet: nutrition.py $(VAR_DIR)/food_acquired.parquet nutrition.org\n\tpython nutrition.py",
  "script_writes": [
    "to_parquet(final_fct, '../var/fct.parquet')",
    "to_parquet(n, '../var/nutrition.parquet')"
  ],
